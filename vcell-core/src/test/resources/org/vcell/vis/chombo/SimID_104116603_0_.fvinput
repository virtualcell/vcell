# Simulation Parameters
SIMULATION_PARAM_BEGIN
SOLVER CHOMBO_SEMIIMPLICIT_SOLVER
BASE_FILE_NAME /tmp/chrun/d3/SimID_104116603_0_
ENDING_TIME 1.0
TIME_INTERVALS 1
1.0 0.01 50
SIMULATION_PARAM_END

# Model description: FEATURE name handle boundary_conditions
MODEL_BEGIN
FEATURE subdomain1 1 flux flux flux flux flux flux 
FEATURE subdomain0 0 flux flux flux flux flux flux 
MEMBRANE subdomain0_subdomain1_membrane subdomain1 subdomain0 flux flux flux flux flux flux 
MODEL_END

CHOMBO_SPEC_BEGIN
DIMENSION 3
MESH_SIZE 8 8 8
DOMAIN_SIZE 10.0 10.0 10.0
DOMAIN_ORIGIN 0.0 0.0 0.0
SUBDOMAINS 2
subdomain1 1 
IF ((((x - 5.0) ^ 2.0) + ((y - 5.0) ^ 2.0) + ((z - 5.0) ^ 2.0)) - 16.0);
USER ((((x - 5.0) ^ 2.0) + ((y - 5.0) ^ 2.0) + ((z - 5.0) ^ 2.0)) < 16.0);
subdomain0 0 
IF  - ((((x - 5.0) ^ 2.0) + ((y - 5.0) ^ 2.0) + ((z - 5.0) ^ 2.0)) - 16.0);
USER 1.0;
MAX_BOX_SIZE 32
FILL_RATIO 0.9
RELATIVE_TOLERANCE 1.0E-7
SAVE_VCELL_OUTPUT true
SAVE_CHOMBO_OUTPUT true
ACTIVATE_FEATURE_UNDER_DEVELOPMENT false
SMALL_VOLFRAC_THRESHOLD 0.0
BLOCK_FACTOR 4
TAGS_GROW 2
REFINEMENTS 1 2
REFINEMENT_ROIS Membrane 0
REFINEMENT_ROIS Volume 0
VIEW_LEVEL 0
CHOMBO_SPEC_END

# Variables : type name domain time_dependent_flag advection_flag grad_flag solve_whole_mesh_flag solve_regions
VARIABLE_BEGIN
VOLUME_PDE C_cyt subdomain1 false false false false subdomain1
VOLUME_PDE Ran_cyt subdomain1 false false false false subdomain1
VOLUME_PDE RanC_cyt subdomain1 false false false false subdomain1
VOLUME_PDE RanC_nuc subdomain1 false false false false subdomain1
MEMBRANE_ODE s2 subdomain0_subdomain1_membrane
VARIABLE_END

POST_PROCESSING_BLOCK_BEGIN
POST_PROCESSING_BLOCK_END

COMPARTMENT_BEGIN subdomain1

EQUATION_BEGIN RanC_cyt
INITIAL 0.0;
RATE ( - (RanC_cyt - (1000.0 * C_cyt * Ran_cyt)) - (2.0 * (RanC_cyt - RanC_nuc)));
DIFFUSION 10.0;
VELOCITY_X 0.0;
VELOCITY_Y 0.0;
VELOCITY_Z 0.0;
BOUNDARY_XM 0.0;
BOUNDARY_XP 0.0;
BOUNDARY_YM 0.0;
BOUNDARY_YP 0.0;
BOUNDARY_ZM 0.0;
BOUNDARY_ZP 0.0;
EQUATION_END

EQUATION_BEGIN Ran_cyt
INITIAL 0.0;
RATE (RanC_cyt - (1000.0 * C_cyt * Ran_cyt));
DIFFUSION 10.0;
VELOCITY_X 0.0;
VELOCITY_Y 0.0;
VELOCITY_Z 0.0;
BOUNDARY_XM 0.0;
BOUNDARY_XP 0.0;
BOUNDARY_YM 0.0;
BOUNDARY_YP 0.0;
BOUNDARY_ZM 0.0;
BOUNDARY_ZP 0.0;
EQUATION_END

EQUATION_BEGIN C_cyt
INITIAL 0.0;
RATE (RanC_cyt - (1000.0 * C_cyt * Ran_cyt));
DIFFUSION 10.0;
VELOCITY_X 0.0;
VELOCITY_Y 0.0;
VELOCITY_Z 0.0;
BOUNDARY_XM 0.0;
BOUNDARY_XP 0.0;
BOUNDARY_YM 0.0;
BOUNDARY_YP 0.0;
BOUNDARY_ZM 0.0;
BOUNDARY_ZP 0.0;
EQUATION_END

EQUATION_BEGIN RanC_nuc
INITIAL (1.0E-8 * (floor((0.8 * x)) + (100.0 * floor((0.8 * y))) + (10000.0 * floor((0.8 * z)))));
RATE (2.0 * (RanC_cyt - RanC_nuc));
DIFFUSION 10.0;
VELOCITY_X 0.0;
VELOCITY_Y 0.0;
VELOCITY_Z 0.0;
BOUNDARY_XM 0.0;
BOUNDARY_XP 0.0;
BOUNDARY_YM 0.0;
BOUNDARY_YP 0.0;
BOUNDARY_ZM 0.0;
BOUNDARY_ZP 0.0;
EQUATION_END

COMPARTMENT_END

COMPARTMENT_BEGIN subdomain0

COMPARTMENT_END


MEMBRANE_BEGIN subdomain0_subdomain1_membrane subdomain1 subdomain0

EQUATION_BEGIN s2
INITIAL (floor((0.8 * x)) + (100.0 * floor((0.8 * y))) + (10000.0 * floor((0.8 * z))));
RATE 0.0;
EQUATION_END

JUMP_CONDITION_BEGIN RanC_cyt
FLUX subdomain1 0.0;
JUMP_CONDITION_END

JUMP_CONDITION_BEGIN Ran_cyt
FLUX subdomain1 0.0;
JUMP_CONDITION_END

JUMP_CONDITION_BEGIN C_cyt
FLUX subdomain1 0.0;
JUMP_CONDITION_END

JUMP_CONDITION_BEGIN RanC_nuc
FLUX subdomain1 0.0;
JUMP_CONDITION_END

MEMBRANE_END

