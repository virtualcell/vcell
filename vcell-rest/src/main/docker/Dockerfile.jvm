####
# Container for the Quarkus application in JVM mode: the vcell-rest and vcell-exporter images
# (CI-full.yml and docker/build/build.sh build both from this file).
#
# Before building the container image run:
#
#   mvn package -pl vcell-rest -am
#
# Then, build the image with:
#
#   docker build -f src/main/docker/Dockerfile.jvm -t vcell-rest-jvm vcell-rest
#
# Base image: Eclipse Temurin 17 JRE, on the floating 17-jre tag so every image build picks up
# the current Java 17 patch release (as the other VCell images do with eclipse-temurin:17).
# It replaced registry.access.redhat.com/ubi8/openjdk-17:1.16, which was pinned to OpenJDK
# 17.0.8 (July 2023) and has had no newer public build since 2024 — so it could not take the
# fix for CVE-2026-114938 ("Java4Shell"), first in 17.0.21.1.
#
# Startup reproduces what the ubi8 image's run-java.sh did, so heap sizing and GC behave as
# before (captured from run-java.sh in vcell-rest:8.1.8.07):
#   java $JAVA_OPTS <JAVA_DEFAULT_OPTS> $JAVA_OPTS_APPEND -jar $JAVA_APP_JAR
# - JAVA_OPTS: set below and replaced wholesale by the deployment (vcell-fluxcd rest.yaml /
#   export.yaml).
# - JAVA_DEFAULT_OPTS: run-java.sh's defaults. MaxRAMPercentage=50 matters: plain java would
#   cap the heap at 25% of the container limit.
# - JAVA_OPTS_APPEND: optional extra options, appended last.
# The process runs as uid 185 "jboss", group 0, home /home/jboss, as in the ubi8 image:
# ResourceUtil derives VCell's working directories from user.home.
###
FROM eclipse-temurin:17-jre

ENV LANG=C.utf8 \
    LANGUAGE='en_US:en'

RUN useradd --uid 185 --gid 0 --home-dir /home/jboss --create-home \
            --shell /usr/sbin/nologin --comment "JBoss user" jboss \
 && mkdir -p /deployments \
 && chown 185:0 /deployments \
 && chmod 775 /deployments

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
WORKDIR /home/jboss

ENV JAVA_OPTS="\
-Dquarkus.http.host=0.0.0.0 \
-Djava.util.logging.manager=org.jboss.logmanager.LogManager \
-Dvcellapi.privateKey.file=/run/secrets/jwt-secret/apiprivkey \
-Dvcellapi.publicKey.file=/run/secrets/jwt-secret/apipubkey \
-XX:+ExitOnOutOfMemoryError \
-XX:+HeapDumpOnOutOfMemoryError \
-XX:HeapDumpPath=/dump"
ENV JAVA_DEFAULT_OPTS="\
-XX:MaxRAMPercentage=50.0 \
-XX:+UseParallelGC \
-XX:MinHeapFreeRatio=10 \
-XX:MaxHeapFreeRatio=20 \
-XX:GCTimeRatio=4 \
-XX:AdaptiveSizePolicyWeight=90 \
-XX:+ExitOnOutOfMemoryError"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

# exec so java is PID 1 and receives SIGTERM from Kubernetes directly.
ENTRYPOINT [ "sh", "-c", "exec java $JAVA_OPTS $JAVA_DEFAULT_OPTS $JAVA_OPTS_APPEND -jar \"$JAVA_APP_JAR\" \"$@\"", "--" ]
